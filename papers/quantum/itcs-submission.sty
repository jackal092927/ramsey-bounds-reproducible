\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{itcs-submission}[2026/09/01 ITCS review-copy font sizes]

% ITCS 2027 requires at least 11pt, whereas unmodified LIPIcs v2021.1.3
% fixes its body at 10pt and its abstract/bibliography at 9pt, and rejects
% an 11pt class option. Keep the official class untouched and adapt only
% review-copy text sizes here (11pt with the standard 13.6pt leading of the
% LaTeX 11pt option). Remove this adapter for LIPIcs camera-ready
% production. Page dimensions, margins, and line numbering are unchanged.
\RequirePackage{etoolbox}
\patchcmd{\normalsize}
  {\@setfontsize\normalsize\@xpt{13}}
  {\@setfontsize\normalsize{11}{13.6}}
  {}{\PackageError{itcs-submission}{Unexpected LIPIcs body-size definition}{Use the bundled LIPIcs v2021.1.3 class.}}
\renewcommand{\small}{\normalsize}
\renewcommand{\footnotesize}{\normalsize}
\renewcommand{\large}{\@setfontsize\large{11}{13.6}}
\patchcmd{\abstract}{\fontsize{9}{12}}{\fontsize{11}{13.6}}
  {}{\PackageError{itcs-submission}{Unexpected LIPIcs abstract-size definition}{Use the bundled LIPIcs v2021.1.3 class.}}
\patchcmd{\thebibliography}{\fontsize{9}{12}}{\fontsize{11}{13.6}}
  {}{\PackageError{itcs-submission}{Unexpected LIPIcs bibliography-size definition}{Use the bundled LIPIcs v2021.1.3 class.}}
\patchcmd{\subjclassHeading}{\fontsize{9}{12}}{\fontsize{11}{13.6}}
  {}{\PackageError{itcs-submission}{Unexpected LIPIcs classification-heading size}{Use the bundled LIPIcs v2021.1.3 class.}}
\patchcmd{\keywordsHeading}{\fontsize{9}{12}}{\fontsize{11}{13.6}}
  {}{\PackageError{itcs-submission}{Unexpected LIPIcs keyword-heading size}{Use the bundled LIPIcs v2021.1.3 class.}}
\normalsize
\endinput
