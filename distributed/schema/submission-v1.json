{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ramsey/submission-v1",
  "title": "Ramsey numerical witness submission v1",
  "description": "Structural contract; ingest additionally enforces n+1, safe paths, exact source/seed/run bindings, completed run and independent graph PASS.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "submission_id",
    "claim",
    "certificate",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "submission_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,79}$"
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "r",
        "s",
        "n",
        "lower_bound",
        "kind"
      ],
      "properties": {
        "r": {
          "type": "integer",
          "minimum": 2,
          "maximum": 20
        },
        "s": {
          "type": "integer",
          "minimum": 2,
          "maximum": 20
        },
        "n": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600
        },
        "lower_bound": {
          "type": "integer",
          "minimum": 2,
          "maximum": 601
        },
        "kind": {
          "enum": [
            "known_baseline",
            "candidate"
          ]
        }
      }
    },
    "certificate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "source_manifest",
        "seeds",
        "run_receipt",
        "budget"
      ],
      "properties": {
        "origin": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "revision",
            "attribution",
            "license_path"
          ],
          "properties": {
            "repository": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "pattern": "^https://"
                }
              ]
            },
            "revision": {
              "type": "string",
              "minLength": 1
            },
            "attribution": {
              "type": "string",
              "minLength": 1
            },
            "license_path": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "source_manifest": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "seeds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        },
        "run_receipt": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "wall_seconds",
            "cpu_count"
          ],
          "properties": {
            "wall_seconds": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "cpu_count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4096
            }
          }
        }
      }
    }
  }
}
