{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ramsey numerical witness run receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "submission_id",
    "claim",
    "certificate_sha256",
    "source_manifest_sha256",
    "seed_sha256",
    "budget",
    "observed"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "submission_id": {
      "type": "string",
      "minLength": 1
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "r",
        "s",
        "n",
        "lower_bound",
        "kind"
      ],
      "properties": {
        "r": {
          "type": "integer",
          "minimum": 2,
          "maximum": 20
        },
        "s": {
          "type": "integer",
          "minimum": 2,
          "maximum": 20
        },
        "n": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600
        },
        "lower_bound": {
          "type": "integer",
          "minimum": 2,
          "maximum": 601
        },
        "kind": {
          "enum": [
            "known_baseline",
            "candidate"
          ]
        }
      }
    },
    "certificate_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "seed_sha256": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wall_seconds",
        "cpu_count"
      ],
      "properties": {
        "wall_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "cpu_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        }
      }
    },
    "observed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "exit_code",
        "elapsed_seconds"
      ],
      "properties": {
        "status": {
          "type": "string"
        },
        "exit_code": {
          "type": [
            "integer",
            "null"
          ]
        },
        "elapsed_seconds": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  }
}
